# Copy this file to .env and adjust values as needed.
# python-dotenv (already in requirements.txt) will load this automatically
# if you add `from dotenv import load_dotenv; load_dotenv()` to run.py,
# or export these variables in your shell / deployment environment.

FLASK_ENV=development
CALMORA_SECRET_KEY=change-this-to-a-long-random-string
CALMORA_DATABASE_URL=sqlite:///instance/calmora.db
